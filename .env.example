# Postgres connection string (use the pooled URL in serverless/production).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth v5 secret. Generate with: npx auth secret
AUTH_SECRET=""

# Optional budget thresholds (percent).
# NEXT_PUBLIC_BUDGET_WARN_THRESHOLD=80
# NEXT_PUBLIC_BUDGET_CRITICAL_THRESHOLD=90
