// Prisma schema for the B2B shop budget-tracking app.
// Postgres is used in all environments. Money is stored as integer cents.
// role/action/entityType are strings validated in app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  name             String
  role             String     @default("COMPANY_ADMIN") // SHOP_ADMIN | COMPANY_ADMIN
  companyId        String?
  company          Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  purchasesCreated Purchase[] @relation("PurchaseCreatedBy")
  auditLogs        AuditLog[]

  @@index([companyId])
}

model Company {
  id            String     @id @default(cuid())
  name          String
  address       String?
  contactPerson String?
  email         String?
  phone         String?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  employees     Employee[]
  admins        User[]
}

model Employee {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String
  annualBudget Int        @default(0) // cents
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  purchases    Purchase[]

  @@index([companyId])
}

model Purchase {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Int // cents
  description String
  notes       String?
  createdById String?
  createdBy   User?    @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // CREATE | UPDATE | DELETE
  entityType String // Company | Employee | Purchase | User
  entityId   String
  changes    String? // JSON string of changed fields
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
